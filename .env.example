# Nextral Environment Variables
# Copy this file to .env and fill in the values

# PostgreSQL
NEXTRAL_POSTGRES_URL=postgres://nextral:nextral@localhost:5432/nextral

# Redis
NEXTRAL_REDIS_URL=redis://localhost:6379

# Qdrant
NEXTRAL_QDRANT_URL=http://localhost:6333
NEXTRAL_QDRANT_API_KEY=

# Neo4j
NEXTRAL_NEO4J_URL=bolt://localhost:7687
NEXTRAL_NEO4J_USER=neo4j
NEXTRAL_NEO4J_PASSWORD=nextraldev

# S3/MinIO
NEXTRAL_S3_ENDPOINT=http://localhost:9000
NEXTRAL_S3_ACCESS_KEY=nextral
NEXTRAL_S3_SECRET_KEY=nextraldev
NEXTRAL_S3_BUCKET=nextral
NEXTRAL_S3_REGION=us-east-1

# Embedding Provider
NEXTRAL_EMBEDDING_PROVIDER=local
NEXTRAL_EMBEDDING_API_KEY=
NEXTRAL_EMBEDDING_MODEL=

# Extraction Provider
NEXTRAL_EXTRACTION_PROVIDER=heuristic

# Reranker Provider
NEXTRAL_RERANKER_PROVIDER=local

# Auth
NEXTRAL_SERVICE_TOKEN=

# Logging
RUST_LOG=info
